<?xml version="1.0" encoding="utf-8"?>
<server>
  <application-settings location="*">
    <session-management>
      <shared-process>
        <num-processes>1</num-processes>
      </shared-process>
      <reload-is-new-session>true</reload-is-new-session>
      <tracking>Auto</tracking>
    </session-management>
    <trusted-proxy-networks>172.16.0.0/12</trusted-proxy-networks>
    <max-request-size>1048576</max-request-size>
    <debug>false</debug>
    <!-- Responsive viewport: inserted verbatim into <head> for every page,
         independent of the AJAX/bootstrap mode (addMetaHeader() is a no-op in
         AJAX sessions). Required so mobile media queries use the device width. -->
    <head-matter>
      <meta name="viewport" content="width=device-width, initial-scale=1" />
    </head-matter>
    <!-- Google OAuth properties (google-oauth2-redirect-endpoint / -client-id /
         -client-secret) are intentionally absent from this committed baseline.
         To enable "Sign in with Google", add a <properties> block with those
         three values to the deployed config: in production that is your
         bind-mounted wt_config.xml (see docker-compose.yml) — this baked-in
         template is never edited. When the properties are absent, Google sign-in
         stays disabled (GoogleService::configured() is false) — note an *empty*
         property still counts as configured, so omit them rather than blank.

         The redirect endpoint MUST include a distinct path (e.g.
         https://your.host/oauth2callback) — NOT the bare application root. Wt
         deploys the OAuth callback as a static resource at that path; a path of
         "/" collides with the app entry point and crashes every sign-in. The same
         URL must be registered as an authorized redirect URI in the Google Cloud
         console. For local testing: http://localhost:<port>/oauth2callback -->
  </application-settings>
</server>
