<?xml version="1.0" encoding="utf-8"?>
<server>
  <application-settings location="*">
    <session-management>
      <shared-process>
        <num-processes>1</num-processes>
      </shared-process>
      <reload-is-new-session>true</reload-is-new-session>
      <tracking>Auto</tracking>
    </session-management>
    <trusted-proxy-networks>172.16.0.0/12</trusted-proxy-networks>
    <max-request-size>1048576</max-request-size>
    <debug>false</debug>
    <!-- Responsive viewport: inserted verbatim into <head> for every page,
         independent of the AJAX/bootstrap mode (addMetaHeader() is a no-op in
         AJAX sessions). Required so mobile media queries use the device width. -->
    <head-matter>
      <meta name="viewport" content="width=device-width, initial-scale=1" />
    </head-matter>
    <!-- Google OAuth properties (google-oauth2-redirect-endpoint / -client-id /
         -client-secret) are intentionally NOT committed here. docker-entrypoint.sh
         injects a <properties> block from the ALTINF_GOOGLE_* env vars at container
         start. When those are unset, no properties exist and Google sign-in stays
         disabled (GoogleService::configured() is false) — note an *empty* property
         still counts as configured, so it must be absent, not blank. The redirect
         endpoint must also be registered in the Google Cloud console. -->
  </application-settings>
</server>
